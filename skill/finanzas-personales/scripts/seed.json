  "recipes": [
    {
      "key": "recipe:spending-by-category",
      "name": "Net amount by top category",
      "definition": {
        "kind": "aggregate",
        "description": "Net amount per top category between start and end: one-off overrides first, then category rules. Internal movements are excluded.",
        "parameters": {
          "start": {
            "type": "date"
          },
          "end": {
            "type": "date"
          }
        },
        "query": {
          "event_type": "transaction",
          "measure": "sum:amount",
          "by": [
            "first(link-in:recategorizes/link:to_category | link:classified_by/fact:categorized_as)/fact:part_of"
          ],
          "where": [
            "first(link-in:recategorizes/link:to_category | link:classified_by/fact:categorized_as)/fact:part_of != category:internal"
          ],
          "since": "{start}",
          "until": "{end}",
          "order": "value"
        }
      }
    },
    {
      "key": "recipe:spending-by-subcategory",
      "name": "Net amount by subcategory",
      "definition": {
        "kind": "aggregate",
        "description": "Net amount per subcategory between start and end: one-off overrides first, then category rules. Internal movements are excluded.",
        "parameters": {
          "start": {
            "type": "date"
          },
          "end": {
            "type": "date"
          }
        },
        "query": {
          "event_type": "transaction",
          "measure": "sum:amount",
          "by": [
            "first(link-in:recategorizes/link:to_category | link:classified_by/fact:categorized_as)"
          ],
          "where": [
            "first(link-in:recategorizes/link:to_category | link:classified_by/fact:categorized_as)/fact:part_of != category:internal"
          ],
          "since": "{start}",
          "until": "{end}",
          "order": "value"
        }
      }
    },
    {
      "key": "recipe:overrides",
      "name": "Transactions with a category override",
      "definition": {
        "kind": "list",
        "description": "Transactions whose category was chosen one by one, between start and end.",
        "parameters": {
          "start": {
            "type": "date"
          },
          "end": {
            "type": "date"
          }
        },
        "query": {
          "event_type": "transaction",
          "where": [
            "has:link-in:recategorizes"
          ],
          "columns": [
            "key",
            "occurred_at",
            "attr:amount",
            "summary",
            "link-in:recategorizes/link:to_category"
          ],
          "since": "{start}",
          "until": "{end}",
          "order_by": [
            "occurred_at"
          ]
        }
      }
    },
    {
      "key": "recipe:uncategorized",
      "name": "Transactions without category",
      "definition": {
        "kind": "list",
        "description": "Transactions whose merchant, counterparty or kind has no category rule and no override.",
        "parameters": {},
        "query": {
          "event_type": "transaction",
          "where": [
            "no:first(link-in:recategorizes/link:to_category | link:classified_by/fact:categorized_as)"
          ],
          "columns": [
            "key",
            "occurred_at",
            "attr:amount",
            "summary",
            "link:classified_by/key"
          ],
          "order_by": [
            "occurred_at"
          ],
          "limit": 200
        }
      }
    },
    {
      "key": "recipe:monthly-cashflow",
      "name": "Cash flow by month and top category",
      "definition": {
        "kind": "aggregate",
        "description": "Net amount per month and top category (overrides first, then rules). Income is positive, spending negative.",
        "parameters": {
          "start": {
            "type": "date"
          },
          "end": {
            "type": "date"
          }
        },
        "query": {
          "event_type": "transaction",
          "measure": "sum:amount",
          "by": [
            "period:month",
            "first(link-in:recategorizes/link:to_category | link:classified_by/fact:categorized_as)/fact:part_of"
          ],
          "where": [
            "first(link-in:recategorizes/link:to_category | link:classified_by/fact:categorized_as)/fact:part_of != category:internal"
          ],
          "since": "{start}",
          "until": "{end}",
          "order": "group"
        }
      }
    },
    {
      "key": "recipe:classifier-history",
      "name": "Transactions of one merchant, counterparty or kind",
      "definition": {
        "kind": "list",
        "description": "Every transaction classified by one merchant, counterparty or transaction kind.",
        "parameters": {
          "who": {
            "type": "entity"
          }
        },
        "query": {
          "event_type": "transaction",
          "where": [
            "link:classified_by = {who}"
          ],
          "columns": [
            "key",
            "occurred_at",
            "attr:amount",
            "summary",
            "link:on_account"
          ],
          "order_by": [
            "occurred_at"
          ],
          "limit": 500
        }
      }
    },
    {
      "key": "recipe:budgets",
      "name": "Budgets in force",
      "definition": {
        "kind": "list",
        "description": "Categories with a monthly budget in force.",
        "parameters": {},
        "query": {
          "entity_type": "category",
          "where": [
            "has:fact:monthly_budget"
          ],
          "columns": [
            "key",
            "name",
            "fact:monthly_budget"
          ],
          "order_by": [
            "key"
          ]
        }
      }
    }
  ]
}
